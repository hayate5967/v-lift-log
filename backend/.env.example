# backend 用の環境変数。コピーして .env を作る:  cp .env.example .env
# Prisma CLI は backend/.env を読むため、DATABASE_URL はここに置く必要がある。
# .env はコミットしない。値を増やしたらこの雛形も更新すること。

# ルートの docker-compose で起動した Postgres を指す。
# ルートの .env で DB_PORT を変えた場合は、ここのポートも合わせる。
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vliftlog?schema=public

# 本番では必ずランダムな値に置き換える
JWT_SECRET=change-me-in-local-only
JWT_EXPIRES_IN=7d

PORT=3000
