# ルートの .env は docker-compose 専用（compose が自動で読み込む）。
# コピーして .env を作る:  cp .env.example .env
#
# アプリの環境変数はそれぞれのディレクトリにある:
#   backend/.env.example   -> backend/.env      (DATABASE_URL, JWT_SECRET など)
#   frontend/.env.example  -> frontend/.env.local
# Prisma CLI は backend/.env しか読まないため、この分割が必要。

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vliftlog

# ホストで 5432 が埋まっている場合はここを変える。
# 変えたら backend/.env の DATABASE_URL のポートも合わせること。
DB_PORT=5432
