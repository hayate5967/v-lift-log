# このファイルをコピーして .env を作る:  cp .env.example .env
# .env は絶対にコミットしない（.gitignore 済み）。値を増やしたらこの雛形も更新すること。
# docker compose はリポジトリ直下の .env を自動で読む。

# ---- docker-compose (PostgreSQL) ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=vliftlog
# ホストで 5432 が埋まっている場合はここを変える（DATABASE_URL のポートも合わせる）
DB_PORT=5432

# ---- backend (NestJS / Prisma) ----
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vliftlog?schema=public
# 本番では必ずランダムな値に置き換える
JWT_SECRET=change-me-in-local-only
JWT_EXPIRES_IN=7d
PORT=3000

# ---- frontend (Next.js) ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
